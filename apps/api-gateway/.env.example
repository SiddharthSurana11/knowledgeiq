# =============================================================================
# KnowledgeIQ — API Gateway .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DB=knowledgeiq

# --- Pinecone ---
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX=knowledgeiq

# --- Object Storage ---
# Supported providers: minio
# To switch provider in future: change STORAGE_PROVIDER and add matching credentials below.
STORAGE_PROVIDER=minio

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_BUCKET=knowledgeiq
MINIO_USE_SSL=false

# --- Claude API ---
CLAUDE_API_KEY=<your-anthropic-api-key>
# Not used by the gateway directly — used by llm-service
CLAUDE_GRPC_HOST=localhost:50051

# --- gRPC Service Hosts ---
EMBEDDING_GRPC_HOST=127.0.0.1:50052
LLM_GRPC_HOST=127.0.0.1:50053

# --- App ---
PORT=5000
NODE_ENV=development
