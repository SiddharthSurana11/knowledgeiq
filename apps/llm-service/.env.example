# =============================================================================
# KnowledgeIQ — LLM Service .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DB=knowledgeiq

# --- LLM Provider Selection ---
# Valid values: groq | gemini | openrouter | claude
# Failover chain (comma-separated): tries each provider in order on transient errors
LLM_PROVIDER=groq
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# --- Groq (Primary high-throughput model) ---
# GROQ_MODEL=llama-3.1-8b-instant has the highest daily request ceiling for volume.
# Note: llama-3.3-70b-versatile is also available, but has lower daily/token caps.
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2500

# --- Gemini (Single API key — single account per ToS) ---
GEMINI_API_KEY=<your-google-api-key>
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=2500

# --- OpenRouter (Fallback — pinned free tier model) ---
# Note: OpenRouter free-tier models sit behind a shared public pool with variable latency.
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MAX_TOKENS=2500
# OPENROUTER_TEMPERATURE=0.1

# --- Few-shot Learning ---
FEWSHOT_PATH=./few_shot_examples.json
FEWSHOT_LIMIT=20

# --- gRPC ---
LLM_GRPC_PORT=50053

# --- Provider Failover ---
PROVIDER_HEALTH_PENALTY_SECONDS=60

# --- Debug ---
LLM_DEBUG_MODE=false
