# =============================================================================
# KnowledgeIQ — Frontend .env.example
# Copy this file to .env and fill in your actual values.
# All variables must be prefixed with VITE_ to be accessible in the browser.
# =============================================================================

# URL of the running API Gateway
VITE_API_GATEWAY_URL=http://localhost:5000

# Alias used by some admin/feedback routes
VITE_API_BASE=http://localhost:5000
