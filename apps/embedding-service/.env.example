# =============================================================================
# KnowledgeIQ — Embedding Service .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DB=knowledgeiq

# --- Pinecone ---
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX=knowledgeiq

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Must match PINECONE_DIM — all-MiniLM-L6-v2 produces 384 dimensions
PINECONE_DIM=384

# --- Chunking ---
CHUNK_TOKEN_LIMIT=800
CHUNK_OVERLAP=100

# --- gRPC ---
EMBEDDING_GRPC_PORT=50052

# --- Debug ---
DEBUG_OUTPUT=False
